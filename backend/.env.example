# ========================================================
# Janogon News Backend Environment Configuration
# ========================================================

# Server Config
PORT=5000
NODE_ENV=development

# --------------------------------------------------------
# 1. Primary MariaDB Database
# --------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=janogon_db
DB_CONNECTION_LIMIT=10

# --------------------------------------------------------
# 2. Secondary MariaDB (For Final Backup / Replica)
# --------------------------------------------------------
BACKUP_DB_HOST=localhost
BACKUP_DB_PORT=3306
BACKUP_DB_USER=root
BACKUP_DB_PASSWORD=
BACKUP_DB_NAME=janogon_db_backup

# --------------------------------------------------------
# 3. Storage Provider Configuration (Backblaze B2 / S3 / R2)
# Any S3-compatible provider works seamlessly!
# --------------------------------------------------------
STORAGE_PROVIDER=b2
STORAGE_ENDPOINT=https://s3.us-west-004.backblazeb2.com # Or your B2 / S3 / R2 endpoint
STORAGE_REGION=us-west-004
STORAGE_ACCESS_KEY_ID=your_b2_key_id
STORAGE_SECRET_ACCESS_KEY=your_b2_application_key
STORAGE_BUCKET_NAME=janogon-news-images
STORAGE_BACKUP_BUCKET_NAME=janogon-admin-backups

# --------------------------------------------------------
# 4. Cloudflare CDN Configuration
# Database will store relative paths (e.g., "uploads/2026/10/image.webp")
# CDN_BASE_URL will be prefixed to serve fast cached images.
# If CDN is changed or bypassed, changing this URL keeps all images working!
# --------------------------------------------------------
CDN_BASE_URL=https://cdn.janogon.news
