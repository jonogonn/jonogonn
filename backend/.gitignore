# ========================================================
# Janogon Backend Git Ignore Configuration
# ========================================================

# Dependencies
node_modules/

# Environment Variables (Never commit real credentials to Git!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Build Output
dist/
build/
*.tsbuildinfo

# Local Development Uploads & Temporary Files
public/uploads/*
!public/uploads/.gitkeep
temp/
tmp/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS & Editor Specific Files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
