# Jonogon News - Apache / LiteSpeed Configuration
# Ensures API endpoints execute as PHP, Social Previews work on /news/*, and SPA client routes work smoothly.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Allow direct execution of /api/ PHP endpoints and /uploads/
  RewriteCond %{REQUEST_URI} ^/(api|uploads)/ [NC]
  RewriteRule ^ - [L]

  # 2. Allow direct access to real existing files and folders (e.g. assets, images)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Dynamic Social Previews & Fast Hydration for News articles (Facebook, WhatsApp, Messenger, etc.)
  RewriteRule ^(?:.*/)?(news|article|p)/([^/]+)/?$ share.php?slug=$2 [QSA,L]

  # 4. Route all other requests to index.html for React SPA (if index.html exists)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# Force UTF-8 Encoding
AddDefaultCharset UTF-8
