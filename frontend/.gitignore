# ========================================================
# Janogon Frontend (Next.js) Git Ignore Configuration
# ========================================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build & Static Outputs
/.next/
/out/
/build
/dist

# Environment Variables (Secrets)
.env
.env*.local
.env.production
.env.development

# Vercel & Deployment
.vercel

# TypeScript & Cache
*.tsbuildinfo
next-env.d.ts

# Testing
/coverage

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# OS & Editor Specific Files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
