# Jonogon News - Apache / LiteSpeed Configuration
# Ensures API endpoints execute as PHP, /uploads/ streams from B2/Cloudflare, Social Previews work on /news/*, and SPA routes work smoothly.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Allow direct execution of /api/ PHP endpoints
  RewriteCond %{REQUEST_URI} ^/(?:.+/)?api/ [NC]
  RewriteRule ^ - [L]

  # 2. Dynamic B2 Streamer & Cloudflare Cache for /uploads/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(?:janogon/)?uploads/(.+)$ /api/uploads_proxy.php?file=$1 [QSA,L]

  # 3. Dynamic XML Sitemap Handlers (Google News 48h & Full Archive)
  RewriteRule ^(?:.*/)?sitemap-news\.xml$ /sitemap.php?type=news [QSA,L]
  RewriteRule ^(?:.*/)?sitemap\.xml$ /sitemap.php?type=main [QSA,L]

  # 4. Allow direct access to real existing files and folders (e.g. assets, existing images, robots.txt)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 5. Dynamic Social Previews & Fast Hydration for News articles (Facebook, WhatsApp, Messenger, etc.)
  RewriteRule ^(?:.*/)?(news|article|p)/([^/]+)/?$ /share.php?slug=$2 [QSA,L]

  # 6. Route all other requests to index.html for React SPA (if index.html exists)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# Force UTF-8 Encoding
AddDefaultCharset UTF-8
